{
  "opencollection": "1.0.0",
  "info": {
    "name": "BitOasis Exchange Account Fiat Deposits API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fiat Deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List fiat deposits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitoasis.net/v1/exchange/fiat-deposits",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "ISO date to filter results from."
              }
            ]
          },
          "docs": "Fiat deposit history."
        },
        {
          "info": {
            "name": "Get fiat deposit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitoasis.net/v1/exchange/fiat-deposit/:deposit_id",
            "params": [
              {
                "name": "deposit_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fiat deposit details by ID."
        }
      ]
    }
  ],
  "bundled": true
}