          "name": "Place order",
          "request": {
            "name": "Place order",
            "description": {
              "content": "Place a limit, market, stop, or stop_limit order. Pass test=true to validate the order without executing it (sandbox / dry-run mode).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "exchange",
                "order"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "test",
                  "value": "<boolean>",
                  "description": "When true, validates the order without placing it."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
